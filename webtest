<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Awesome Landing Page</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .hero-bg {
            background-color: #1a202c; /* A dark slate gray, you can change this */
            background-image: linear-gradient(to bottom right, #1a202c, #2d3748);
        }
        .section-title {
            @apply text-3xl font-bold text-center mb-8 text-gray-800;
        }
        .card {
            @apply bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300;
        }
        .btn {
            @apply px-6 py-3 rounded-md font-semibold transition-colors duration-300;
        }
        .btn-primary {
            @apply bg-blue-600 text-white hover:bg-blue-700;
        }
        .btn-secondary {
            @apply bg-gray-200 text-gray-800 hover:bg-gray-300;
        }
        nav a {
            @apply hover:text-blue-500 transition-colors duration-300;
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-700">

    <header class="bg-white shadow-md sticky top-0 z-50">
        <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
            <a href="#" class="text-2xl font-bold text-blue-600">MyPage</a>
            <div class="space-x-4">
                <a href="#home" class="text-gray-600">Home</a>
                <a href="#about" class="text-gray-600">About</a>
                <a href="#services" class="text-gray-600">Services</a>
                <a href="#contact" class="text-gray-600">Contact</a>
            </div>
        </nav>
    </header>

    <section id="home" class="hero-bg text-white py-20 md:py-32">
        <div class="container mx-auto px-6 text-center">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">Welcome to Our Awesome Page!</h1>
            <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto">Discover amazing things and connect with us. We are here to provide you with the best experience.</p>
            <div>
                <a href="#services" class="btn btn-primary mr-2 mb-2 md:mb-0">Our Services</a>
                <a href="#contact" class="btn btn-secondary">Contact Us</a>
            </div>
        </div>
    </section>

    <section id="about" class="py-16 md:py-24 bg-white">
        <div class="container mx-auto px-6">
            <h2 class="section-title">About Us</h2>
            <div class="flex flex-col md:flex-row items-center">
                <div class="md:w-1/2 mb-8 md:mb-0 md:pr-8">
                    <img src="https://placehold.co/600x400/E2E8F0/2D3748?text=About+Us+Image" alt="About Us" class="rounded-lg shadow-lg w-full h-auto">
                     <img src="https://placehold.co/600x400/cccccc/333333?text=Image+Not+Found" alt="Image Not Found" class="rounded-lg shadow-lg w-full h-auto hidden" onerror="this.style.display='block'; this.previousElementSibling.style.display='none';">
                </div>
                <div class="md:w-1/2">
                    <p class="text-lg mb-4">
                        We are a passionate team dedicated to creating innovative solutions and providing top-notch services. Our mission is to empower individuals and businesses through technology and creativity.
                    </p>
                    <p class="text-lg mb-4">
                        With years of experience in the industry, we have honed our skills to deliver excellence in every project we undertake. We believe in collaboration, transparency, and continuous improvement.
                    </p>
                    <ul class="list-disc list-inside text-lg space-y-2">
                        <li>Commitment to Quality</li>
                        <li>Customer-Centric Approach</li>
                        <li>Innovative Solutions</li>
                        <li>Experienced Team</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section id="services" class="py-16 md:py-24 bg-gray-50">
        <div class="container mx-auto px-6">
            <h2 class="section-title">Our Services</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="card text-center">
                    <div class="text-blue-600 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2 text-gray-800">Web Development</h3>
                    <p>Crafting beautiful, responsive, and high-performing websites tailored to your needs.</p>
                </div>
                <div class="card text-center">
                    <div class="text-blue-600 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2 text-gray-800">Mobile App Design</h3>
                    <p>Designing intuitive and engaging mobile experiences for iOS and Android platforms.</p>
                </div>
                <div class="card text-center">
                    <div class="text-blue-600 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2 text-gray-800">Cloud Solutions</h3>
                    <p>Leveraging cloud technologies to provide scalable, secure, and efficient solutions.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="py-16 md:py-24 bg-white">
        <div class="container mx-auto px-6">
            <h2 class="section-title">Contact Us</h2>
            <div class="max-w-xl mx-auto bg-gray-50 p-8 rounded-lg shadow-lg">
                <form action="#" method="POST"> <div class="mb-4">
                        <label for="name" class="block text-gray-700 font-medium mb-2">Full Name</label>
                        <input type="text" id="name" name="name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="John Doe" required>
                    </div>
                    <div class="mb-4">
                        <label for="email" class="block text-gray-700 font-medium mb-2">Email Address</label>
                        <input type="email" id="email" name="email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="you@example.com" required>
                    </div>
                    <div class="mb-4">
                        <label for="message" class="block text-gray-700 font-medium mb-2">Message</label>
                        <textarea id="message" name="message" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="Your message here..." required></textarea>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary w-full md:w-auto">Send Message</button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <footer class="bg-gray-800 text-gray-300 py-12">
        <div class="container mx-auto px-6 text-center">
            <p>&copy; <span id="currentYear"></span> MyPage. All rights reserved.</p>
            <p class="text-sm mt-2">Designed with <span class="text-red-500">&hearts;</span> using HTML & Tailwind CSS</p>
        </div>
    </footer>

    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

        // Set current year in footer
        document.getElementById('currentYear').textContent = new Date().getFullYear();
    </script>

</body>
</html>
